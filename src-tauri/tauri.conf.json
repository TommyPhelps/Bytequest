{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BYTEQUEST",
  "version": "0.1.0",
  "identifier": "dev.tommy.bytequest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BYTEQUEST.EXE",
        "width": 1480,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "backgroundColor": "#050b18"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Tommy",
    "category": "Education",
    "copyright": "Personal use",
    "shortDescription": "BYTEQUEST - hands-on computing lab",
    "longDescription": "BYTEQUEST hands you real, verifiable computing projects across networking, hardware, Linux, electronics, embedded, algorithms, data and game development. Works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
